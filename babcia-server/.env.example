# Babcia Chat backend — env vars (set these in Render → Environment).
# Never commit a real key. Copy to .env for local dev (.env is gitignored).

# Which LLM to use for translation: "anthropic" or "openai"
LLM_PROVIDER=anthropic
# Your LLM API key (Render env var). If unset, the server uses a MOCK translator.
LLM_API_KEY=
# Optional model override (defaults: claude-haiku-4-5-20251001 / gpt-4o-mini)
LLM_MODEL=

# Postgres connection (Render provides this for its managed Postgres).
# If unset, the server uses an in-memory store (dev only, NOT persistent).
DATABASE_URL=

# Comma-separated extra allowed CORS origins (lab.bukowiecki.co + localhost are
# always allowed). Usually leave blank.
CORS_ORIGIN=

# Port (Render sets this automatically; local default is 8790).
PORT=8790
